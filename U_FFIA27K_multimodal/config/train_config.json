{
  "epochs": 400,
  "batch_size": 32,
  "learning_rate": 1e-4,
  "weight_decay": 1e-2,
  "monitor": "val_f1_macro",
  "mode": "max",
  "early_stopping": true,
  "patience": 80,
  "min_delta": 0.0005,
  "lr_scheduler": "cosine",
  "warmup_epochs": 5,
  "min_lr": 1e-6,
  "num_frames": 4,
  "image_size": 224,
  "sample_rate": 64000,
  "cache_mode": "ram",
  "dataloader_workers": -1,
  "prefetch_factor": 2,
  "ckpt_dir": "checkpoint",
  "save_best_only": true,
  "loss_type": "ordinal_wasserstein",
  "ordinal_sigma": 0.5,
  "lambda_ord_start": 0.2,
  "lambda_ord_end": 2.0,
  "model": {
    "backbone": "MultimodalSOTANet",
    "classes_num": 4,
    "embed_dim": 224,
    "num_bottlenecks": 4,
    "num_heads": 4,
    "pretrained_video": true
  },
  "audio_features": {
    "sample_rate": 64000,
    "window_size": 2048,
    "hop_size": 512,
    "mel_bins": 128,
    "fmin": 50,
    "fmax": 32000
  },
  "dataset_splitter": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "seed": 42,
    "test_sample_per_class": 700,
    "save_results": true,
    "include_video": true,
    "split_strategy": "random_sample",
    "evaluation_mode": "holdout",
    "num_folds": 5,
    "fold_index": null,
    "cv_val_ratio": 0.2
  }
}

{
  "system": {
    "seed": 0,
    "cache_mode": "ram",
    "dataloader_workers": 8,
    "prefetch_factor": 2,
    "ckpt_dir": "checkpoint"
  },
  "training": {
    "epochs": 400,
    "batch_size": 32,
    "learning_rate": 0.001,
    "weight_decay": 0.05,
    "use_onecycle": true
  },
  "evaluation": {
    "monitor": "val_acc",
    "mode": "max",
    "early_stopping": false,
    "patience": 100,
    "min_delta": 0.0
  },
  "loss": {
    "loss_type": "ce"
  },
  "model": {
    "backbone": "AudioSOTANet",
    "classes_num": 4,
    "embed_dim": 384
  },
  "audio_mlp_ablation": {
    "active_config": "W_768_balanced",
    "embed_dim": 384,
    "dropout": 0.1,
    "presets": {
      "L0_linear": [],
      "W_256_bottleneck": [256],
      "W_512_moderate": [512],
      "W_768_balanced": [768],
      "W_1024_wide": [1024],
      "W_2048_expansion": [2048],
      "L2_pyramidal_1024_512": [1024, 512],
      "L2_compact_768_512": [768, 512],
      "L2_wide_1024_768": [1024, 768],
      "L3_deep_1024_768_512": [1024, 768, 512]
    }
  },
  "audio_features": {
    "sample_rate": 256000,
    "window_size": 4096,
    "hop_size": 2048,
    "use_tkeo": true,
    "alpha_max": 0.99,
    "beta": 0.8,
    "use_spectral_aug": true,
    "cutout_width": 24,
    "cutout_prob": 0.5,
    "noise_std": 0.02
  },
  "dataset_splitter": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "seed": 42,
    "test_sample_per_class": 700,
    "save_results": true,
    "include_video": false,
    "split_strategy": "random_sample",
    "evaluation_mode": "holdout",
    "num_folds": 5,
    "fold_index": null,
    "cv_val_ratio": 0.2
  }
}
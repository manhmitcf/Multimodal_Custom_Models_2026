{
  "system": {
    "seed": 0,
    "cache_mode": "ram",
    "dataloader_workers": 8,
    "prefetch_factor": 2,
    "ckpt_dir": "checkpoint"
  },
  "training": {
    "epochs": 400,
    "batch_size": 32,
    "learning_rate": 0.001,
    "weight_decay": 0.05,
    "use_onecycle": true
  },
  "evaluation": {
    "monitor": "val_acc",
    "mode": "max",
    "early_stopping": false,
    "patience": 100,
    "min_delta": 0.0
  },
  "loss": {
    "loss_type": "ce"
  },
  "model": {
    "backbone": "VideoSOTANet",
    "classes_num": 4,
    "embed_dim": 384,
    "video_drop_path": 0.1
  },
  "video_ablation": {
    "active_config": "C7_full",
    "temporal_mode": "sum",
    "embed_dim": 384,
    "presets": {
      "C3_rgb": [0, 1, 2],
      "C4_rgb_mag": [0, 1, 2, 5],
      "C4_rgb_vorticity": [0, 1, 2, 6],
      "C5_rgb_flow": [0, 1, 2, 3, 4],
      "C5_rgb_scalars": [0, 1, 2, 5, 6],
      "C6_rgb_flow_mag": [0, 1, 2, 3, 4, 5],
      "C6_rgb_flow_vorticity": [0, 1, 2, 3, 4, 6],
      "C7_full": [0, 1, 2, 3, 4, 5, 6]
    }
  },
  "video_features": {
    "image_size": 224,
    "num_frames": 2,
    "num_channels": 7
  },
  "audio_features": {
    "sample_rate": 256000,
    "window_size": 4096,
    "hop_size": 2048,
    "use_tkeo": true,
    "alpha_max": 0.99,
    "beta": 0.8,
    "use_spectral_aug": true,
    "cutout_width": 24,
    "cutout_prob": 0.5,
    "noise_std": 0.02
  },
  "dataset_splitter": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "seed": 42,
    "test_sample_per_class": 700,
    "save_results": true,
    "include_video": true,
    "include_audio": false,
    "split_strategy": "random_sample",
    "evaluation_mode": "holdout",
    "num_folds": 5,
    "fold_index": null,
    "cv_val_ratio": 0.2
  }
}
{
  "seed": 42,
  "epochs": 400,
  "batch_size": 32,

  "learning_rate": 1e-3,
  "min_lr": 1e-6,
  "weight_decay": 0.05,
  "max_norm": 5.0,

  "lr_scheduler": "cosine",
  "use_warmup": true,
  "warmup_pct": 0.05,

  "monitor": "qwk",
  "mode": "max",
  "early_stopping": false,
  "patience": 100,

  "loss_type": "pairwise_tournament",
  "weight_ce": 1.0,
  "weight_act": 0.5,
  "weight_pairwise": 0.5,
  "aux_loss_weight": 0.3,

  "image_size": 224,
  "num_frames": 2,
  "sample_rate": 256000,

  "cache_mode": "ram",
  "dataloader_workers": -1,
  "prefetch_factor": 2,
  "ckpt_dir": "checkpoint",
  "save_best_only": true,

  "model": {
    "backbone": "MultimodalSOTANet",
    "classes_num": 4,
    "embed_dim": 224
  },

  "audio_features": {
    "sample_rate": 256000,
    "window_size": 4096,
    "hop_size": 2048,
    "mel_bins": 2049,
    "use_tkeo": true,
    "alpha_max": 0.99,
    "use_spectral_aug": false
  },

  "dataset_splitter": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "split_strategy": "random_sample",
    "evaluation_mode": "holdout",
    "test_sample_per_class": 700,
    "seed": 42
  }
}
